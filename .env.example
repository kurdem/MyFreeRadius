# =============================================================================
# FreeRADIUS Manager - Example environment configuration
#
# Copy this file to `.env` and adjust the values. NEVER commit a real `.env`.
#   cp .env.example .env
#
# All secrets below MUST be changed before any non-local use.
# For SECRET_KEY and RADIUS_AGENT_TOKEN, generate strong random values, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# FERNET_KEY is special - it needs a real Fernet key (see below), not this.
# =============================================================================

# ---------------------------------------------------------------------------
# General
# ---------------------------------------------------------------------------
# dev  -> relaxed cookie flags (Secure disabled), verbose errors
# prod -> hardened cookies, generic errors
APP_ENV=dev
TZ=Europe/Berlin

# Host port the web UI is published on (container listens on 8080 internally).
# Change this if 8080 is already in use on the host, e.g. FRONTEND_HTTP_PORT=8090.
FRONTEND_HTTP_PORT=8080

# ---------------------------------------------------------------------------
# Backend security
# ---------------------------------------------------------------------------
# Signs session (JWT) cookies. 32+ random bytes.
SECRET_KEY=change-me-please-generate-a-long-random-value

# Fernet key used to encrypt shared secrets / bind passwords at rest.
# IMPORTANT: this must be a REAL Fernet key (32 url-safe base64 bytes, 44 chars
# ending in '='). token_urlsafe / hex / arbitrary strings will NOT work.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Changing this later makes already-stored secrets unreadable.
FERNET_KEY=REPLACE_WITH_OUTPUT_OF_Fernet.generate_key()

# Session lifetime in minutes.
SESSION_TTL_MINUTES=480

# Comma-separated list of allowed browser origins for CORS (frontend URL).
# Only relevant if you call the backend cross-origin; in the compose setup the
# frontend proxies /api same-origin. Match FRONTEND_HTTP_PORT if you change it.
CORS_ORIGINS=http://localhost:8080

# ---------------------------------------------------------------------------
# Initial administrator (created once on first startup if no users exist)
# ---------------------------------------------------------------------------
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=change-me-initial-admin-password

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Default: SQLite file inside the data volume.
# For PostgreSQL use e.g.:
#   DATABASE_URL=postgresql+psycopg://radius:radius@database:5432/radiusmgr
DATABASE_URL=sqlite:////data/radiusmgr.db

# PostgreSQL container settings (only used when the `database` service runs).
POSTGRES_DB=radiusmgr
POSTGRES_USER=radius
POSTGRES_PASSWORD=change-me-db-password

# ---------------------------------------------------------------------------
# FreeRADIUS control agent
# ---------------------------------------------------------------------------
# Shared token the backend uses to authenticate to the control agent that
# runs inside the FreeRADIUS container. 32+ random bytes.
RADIUS_AGENT_TOKEN=change-me-agent-token
# Internal URL of the control agent (docker network name).
RADIUS_AGENT_URL=http://freeradius:8000

# ---------------------------------------------------------------------------
# Monitoring (optional profile: docker compose --profile monitoring up -d)
# ---------------------------------------------------------------------------
# Host ports for the bundled Prometheus / Grafana. Only used when the
# `monitoring` profile is active. Change if these ports are already in use.
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
# Initial Grafana admin password (user: admin). Change before any real use.
GRAFANA_ADMIN_PASSWORD=admin
