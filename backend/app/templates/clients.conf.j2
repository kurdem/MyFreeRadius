{# clients.conf generated by FreeRADIUS Manager - DO NOT EDIT BY HAND.
   Managed by the web interface; manual changes are overwritten on the next
   "Activate". Source of truth: the application database. #}
# =============================================================================
# clients.conf  -  generated {{ generated_at }}
# version: {{ version }}
# Managed by FreeRADIUS Manager. Manual edits are overwritten.
# =============================================================================
{% for c in clients %}
client {{ c.name }} {
    ipaddr    = {{ c.ipaddr }}
    secret    = "{{ c.secret }}"
    shortname = {{ c.name }}
    nas_type  = {{ c.nas_type }}
{% if virtual_server %}    virtual_server = {{ virtual_server }}
{% endif %}{% if c.require_message_authenticator %}    require_message_authenticator = yes
{% endif %}{% if c.description %}    # {{ c.description }}
{% endif %}}
{% endfor %}
{% if not clients %}
# No enabled RADIUS clients configured yet.
{% endif %}
# Loopback client for the built-in "Test Authentication" feature. The secret is
# the agent token (read from the container environment, not stored here). It is
# only reachable from inside the FreeRADIUS container.
client radius_manager_test {
    ipaddr    = 127.0.0.1
    secret    = "$ENV{RADIUS_AGENT_TOKEN}"
    shortname = radius_manager_test
{% if virtual_server %}    virtual_server = {{ virtual_server }}
{% endif %}}
