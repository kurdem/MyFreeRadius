[# mods-enabled/ldap - generated by FreeRADIUS Manager. DO NOT EDIT BY HAND. #]
# =============================================================================
# LDAP module for Active Directory - generated [[ generated_at ]]
# Managed by FreeRADIUS Manager. Manual edits are overwritten on the next
# "Activate". Authentication is done by binding to AD as the user (PAP).
# =============================================================================
ldap {
    server = '[[ server_uri ]]'
    port = [[ port ]]

    identity = '[[ bind_user ]]'
    password = '[[ bind_password ]]'

    base_dn = '[[ base_dn ]]'

    sasl {
    }

    # Find the AD user by sAMAccountName (the Windows logon name).
    user {
        base_dn = "${..base_dn}"
        filter = "(sAMAccountName=%{%{Stripped-User-Name}:-%{User-Name}})"
        scope = 'sub'
    }

    # Group membership via the AD "memberOf" attribute (full group DN).
    group {
        base_dn = "${..base_dn}"
        filter = "(objectClass=group)"
        scope = 'sub'
        name_attribute = cn
        membership_attribute = 'memberOf'
    }

    options {
        chase_referrals = no
        rebind = no
        res_timeout = [[ timeout ]]
        srv_timelimit = [[ timeout ]]
        net_timeout = [[ timeout ]]
        idle = 60
        probes = 3
        interval = 3
    }

    tls {
        require_cert = '[[ require_cert ]]'
    }

    pool {
        start = 1
        min = 1
        max = 5
        spare = 3
        uses = 0
        retry_delay = 30
        lifetime = 0
        idle_timeout = 60
    }
}
