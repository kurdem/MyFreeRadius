[# sites-enabled/manager - generated by FreeRADIUS Manager. DO NOT EDIT BY HAND. #]
# =============================================================================
# Virtual server "manager" - generated [[ generated_at ]]
# Authenticates RADIUS users against Active Directory via LDAP (PAP bind) and
# authorizes based on AD group membership. Replaces the stock "default" site
# while AD is enabled. Managed by FreeRADIUS Manager.
# =============================================================================
server manager {
    listen {
        type = auth
        ipaddr = *
        port = 1812
    }
    listen {
        type = acct
        ipaddr = *
        port = 1813
    }

    authorize {
        preprocess

        # Look the user up in AD. On success the ldap module returns "ok"/"updated".
        ldap

        if (notfound || fail || reject) {
            reject
        }

        # --- AD group authorization ---------------------------------------
[% if deny_groups %]        # Denied groups take precedence.
[% for g in deny_groups %]        if (&LDAP-Group == "[[ g ]]") {
            reject
        }
[% endfor %][% endif %][% if allow_groups %]        # Require membership in at least one allowed group.
        if (!([% for g in allow_groups %]&LDAP-Group == "[[ g ]]"[% if not loop.last %] || [% endif %][% endfor %])) {
            reject
        }
[% else %]        # No allow-groups configured: any authenticated AD user is accepted.
[% endif %]
        # Bind to AD as the user to verify the password (PAP).
        if (!control:Auth-Type) {
            update control {
                Auth-Type := ldap
            }
        }
    }

    authenticate {
        Auth-Type LDAP {
            ldap
        }
        pap
    }

    preacct {
        preprocess
    }

    accounting {
    }

    post-auth {
        Post-Auth-Type REJECT {
        }
    }
}
