[# mods-enabled/rest - generated by FreeRADIUS Manager. DO NOT EDIT BY HAND. #]
# =============================================================================
# rlm_rest module - generated [[ generated_at ]]
# Delegates authentication to the FreeRADIUS Manager backend, which verifies the
# TOTP second factor (and, in append mode, the AD password). The shared token is
# read from the container environment, not stored in this file.
# =============================================================================
rest {
    connect_uri = "[[ backend_url ]]"

    authenticate {
        # The shared token is passed in the query string so it arrives regardless
        # of how rlm_rest encodes the body. The body carries username/password;
        # the backend also accepts rlm_rest's native attribute JSON.
        uri = "[[ backend_url ]]/api/v1/radius/authorize?token=$ENV{RADIUS_AGENT_TOKEN}"
        method = 'post'
        body = 'json'
        data = '{"username":"%{User-Name}","password":"%{User-Password}"}'
    }

    pool {
        start = 1
        min = 1
        max = 5
        spare = 3
        uses = 0
        retry_delay = 30
        lifetime = 0
        idle_timeout = 60
    }
}
